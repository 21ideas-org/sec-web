---
import { render } from 'astro:content';
import Audience from '../../components/Audience.astro';
import IncidentCta from '../../components/IncidentCta.astro';
import Base from '../../layouts/Base.astro';
import Urgency from '../../components/Urgency.astro';
import Thread from '../../components/Thread.astro';
import { allEnIncidents, allIncidents, dateLong, keepFlags, own, thread, threadStart } from '../../lib.ts';
import { displayUrgency } from '../../status.ts';
import { displaySourceLinks } from '../../source-links.ts';

export async function getStaticPaths() {
  const [list, english] = await Promise.all([allIncidents(), allEnIncidents()]);
  // Хроника собственной страницы не получает: её ссылка ведёт на первоисточник.
  return own(list).map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      posts: thread(list, threadStart(list, entry)),
      counterpartUrl: english.some((candidate) => candidate.id === entry.id)
        ? `/en/incidents/${entry.id}/`
        : undefined,
    },
  }));
}

const { entry, posts, counterpartUrl } = Astro.props;
const d = entry.data;
const start = posts[0];
// Крошка нужна только апдейту: на начале треда она указывала бы на саму страницу.
const isUpdate = start !== undefined && start.id !== entry.id;
const { Content } = await render(entry);
const date = dateLong(d.pubDate);
// Продукт и вендор — надзаголовком. В треде из семи постов про Core Lightning
// заголовки похожи, а «кто это сказал» различает их сразу. Вендор опускается,
// когда совпадает с продуктом: «Core Lightning · Core Lightning» — не строка.
const subject = [d.product, d.vendor !== d.product ? d.vendor : null].filter(Boolean).join(' · ');
const urgency = displayUrgency(d);
const sourceLinks = displaySourceLinks(d.links);
---
<Base
  title={d.title}
  description={d.description}
  type="article"
  pubDate={d.pubDate}
  counterpartUrl={counterpartUrl}
>
  <article class="prose" style="padding-top: 32px">
    {subject && <div class="eyebrow">{subject}</div>}
    <div class="tags">
      <Urgency tags={urgency} />
      <Audience values={d.audience} />
      <span class="aud when">{date}</span>
    </div>
    {
      isUpdate && (
        <p class="up-of">
          Апдейт инцидента: <a href={`/incidents/${start!.id}/`}>{start!.data.title}</a>
        </p>
      )
    }
    <h1 set:html={keepFlags(d.title)} />
    {d.description && <p set:html={keepFlags(d.description)} />}

    {
      d.hijacked && (
        <aside class="hijack panel" role="alert">
          <strong>Похоже, официальный аккаунт {d.vendor ?? 'вендора'} угнан.</strong>
          <p>Не переходите по ссылкам из его постов и никуда не вводите seed.</p>
        </aside>
      )
    }

    {
      d.action && (
        <div class="action panel">
          <div class="k">Что делать</div>
          <p set:html={keepFlags(d.action)} />
        </div>
      )
    }

    {
      !d.hijacked && sourceLinks.length > 0 && (
        <div class="links">
          {sourceLinks.length === 1 ? (
            <p><strong>Источник:</strong> <a href={sourceLinks[0]!.url} rel="noopener">{sourceLinks[0]!.label}</a></p>
          ) : (
            <>
              <p><strong>Источники:</strong></p>
              <ul>
                {sourceLinks.map((link) => (
                  <li><a href={link.url} rel="noopener">{link.label}</a></li>
                ))}
              </ul>
            </>
          )}
        </div>
      )
    }

    <Content />

    <IncidentCta />

    <Thread posts={posts} current={entry.id} />

    {
      d.telegramUrl && (
        <p class="note">
          Это оповещение в Telegram: <a href={d.telegramUrl} rel="noopener">пост</a>
        </p>
      )
    }

  </article>
</Base>
