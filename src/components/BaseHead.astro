---
import { SITE_NAME, SITE_URL } from '../consts.ts';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  locale?: 'ru' | 'en';
  siteName?: string;
  rssUrl?: string | null;
  rssTitle?: string;
  counterpartUrl?: string;
  canonicalPath?: string;
}
const {
  title,
  description,
  image,
  type = 'website',
  pubDate,
  locale = 'ru',
  siteName = SITE_NAME,
  rssUrl = locale === 'ru' ? '/rss.xml' : '/en/rss.xml',
  rssTitle = siteName,
  counterpartUrl,
  canonicalPath,
} = Astro.props;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, SITE_URL);
// Одна статичная карточка на локаль. Legacy /og/{critical,unpatched,patched,default}.png
// остаются в public только ради старых превью и кодом больше не выбираются.
const og = new URL(image ?? `/og/${locale}.png`, SITE_URL);
// Alt повторяет <desc> утверждённых scripts/og/<locale>.svg: в EN-превью нет кириллицы.
const ogAlt = locale === 'ru'
  ? 'Карточка Bitcoin Security Watcher: проект, следящий за критическими анонсами в Биткоине.'
  : 'Bitcoin Security Watcher Open Graph card: Critical Bitcoin Alerts.';
const counterpartLocale = locale === 'ru' ? 'en' : 'ru';
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{rssUrl && <link rel="alternate" type="application/rss+xml" title={rssTitle} href={new URL(rssUrl, SITE_URL)} />}
{
  counterpartUrl && (
    <>
      <link rel="alternate" hreflang={locale} href={canonical} />
      <link rel="alternate" hreflang={counterpartLocale} href={new URL(counterpartUrl, SITE_URL)} />
    </>
  )
}
<link rel="sitemap" href="/sitemap-index.xml" />

<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={og} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={og} />
{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}

<!-- Шрифты свои, из public/fonts: третьей стороны в критическом пути нет.
     Латиница моно предзагружается наравне с кириллицей: цифры лежат именно в ней,
     а самое крупное на первом экране — счётчик на 54px. Без неё он гарантированно
     перерисовывается с системного фоллбэка, и это самый заметный сдвиг на странице.
     Латиница текстового шрифта не предзагружается: бегущий текст ниже сгиба. -->
<link rel="preload" as="font" type="font/woff2" href="/fonts/jetbrains-mono-cyrillic-wght-normal.woff2" crossorigin />
<link rel="preload" as="font" type="font/woff2" href="/fonts/jetbrains-mono-latin-wght-normal.woff2" crossorigin />
<link rel="preload" as="font" type="font/woff2" href="/fonts/ibm-plex-sans-cyrillic-wght-normal.woff2" crossorigin />

<!-- Тема до первой отрисовки, иначе светлая мигнёт на тёмной. Штампуем
     data-theme ТОЛЬКО при явном выборе: без него решает prefers-color-scheme. -->
<script is:inline>
  try {
    var t = localStorage.getItem('sec-theme');
    if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
  } catch (e) {}
</script>
